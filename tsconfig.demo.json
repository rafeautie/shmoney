{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/demo/**/*",
    "src/renderer/src/env.d.ts",
    "src/preload/index.d.ts",
    "vite.demo.config.ts",
    "vite.e2e.config.ts",
    "playwright.config.ts",
    "e2e/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@main/*": ["./src/main/*"],
      "@/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "jsx": "react-jsx"
  }
}
